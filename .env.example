# Copy to .env if you want to override defaults. No secrets are needed: ECMWF Open Data is public.
# Where raw/processed data are stored (default: ./data)
PRECIP_DATA_DIR=./data
# Set to 1 to run the background refresher inside the API process (used in deployment)
PRECIP_AUTO_REFRESH=0
# Seconds between checks for a newer ECMWF run when auto-refresh is on
PRECIP_REFRESH_INTERVAL_S=1800
# Keep downloaded raw GRIB messages after processing (deployment sets 0 to save disk)
PRECIP_KEEP_RAW=1
